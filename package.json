{
    "name": "material-transport-api",
    "version": "1.0.0",
    "description": "Material transport API — sites, trucks, tickets",
    "main": "dist/server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:seed": "tsx src/db/seed.ts",
        "test": "jest --forceExit",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --forceExit"
    },
    "dependencies": {
        "better-sqlite3": "^12.10.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-openapi-validator": "^5.3.7",
        "pino": "^9.2.0",
        "pino-http": "^10.2.0",
        "pino-pretty": "^11.2.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.10",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.14.0",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.15.6",
        "typescript": "^5.4.5"
    }
}
